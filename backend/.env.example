# AgriBot Backend Environment Variables (optional)
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ML Model settings
MODEL_ENABLED=true
MODEL_PATH=models/combined/combined_model.pth
MODEL_CLASSES_PATH=models/combined/class_names.json
MODEL_CONFIDENCE_THRESHOLD=0.50

# Camera & Inference pipeline
FRAME_MAX_WIDTH=640
JPEG_QUALITY=75
STALE_FRAME_SECONDS=5
RECONNECT_BACKOFF_MAX_SECONDS=15
DETECTION_COOLDOWN_SECONDS=2.0
INFERENCE_MAX_FPS=2
